<head>
  <styling>
    <style xml:id="s0" tts:backgroundColor="#000000FF" tts:textAlign="left" tts:color="#FFFF00FF" tts:fontSize="1c" tts:fontFamily="proportionalSansSerif" />
    <style xml:id="transparentspace" tts:backgroundColor="#000000FF" tts:textAlign="left" tts:color="#FFFF00FF" tts:fontSize="1c" tts:fontFamily="proportionalSansSerif" />
